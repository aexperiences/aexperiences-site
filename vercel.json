      "permanent": true
    },
    {
      "source": "/ae-mark.png",
      "destination": "/marks/ae-mark.svg",
      "permanent": false
    }
  ],
  "rewrites": [ { "source": "/apps/wire/", "destination": "https://ae-wire-accelerated-experiences.vercel.app/index.html" },
