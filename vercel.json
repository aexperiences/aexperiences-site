    {
      "source": "/apps/blastpack/:path*",
      "destination": "https://aeblastpack.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data:; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; report-uri /api/csp-report"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/espofocus-nudge",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/kangatodo-alert",
      "schedule": "*/10 * * * *"
    }
  ]
}
